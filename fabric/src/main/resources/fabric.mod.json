{
    "schemaVersion": 1,
    "id": "${archives_name}",
    "version": "${version}",
    "name": "${display_name}",
    "description": "${description}",
    "authors": [
        "NecroSo1"
    ],
    "contact": {
        "homepage": "https://github.com/necro50n3/cobblemon-raiddens",
        "issues": "https://github.com/necro50n3/cobblemon-raiddens/issues"
    },
    "license": "MIT License",
    "icon": "assets/${archives_name}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.necro.raid.dens.fabric.CobblemonRaidDensFabric"
        ],
        "client": [
            "com.necro.raid.dens.fabric.CobblemonRaidDensFabricClient"
        ],
        "jade": [
            "com.necro.raid.dens.common.compat.jade.RaidDensJadePlugin"
        ],
        "modmenu": [
            "com.necro.raid.dens.fabric.compat.modmenu.RaidDensModMenuIntegration"
        ],
        "jei_mod_plugin": [
            "com.necro.raid.dens.common.compat.jei.RaidDensJEIPlugin"
        ],
        "rei_client": [
            "com.necro.raid.dens.common.compat.rei.RaidDensREIPlugin"
        ],
        "emi": [
            "com.necro.raid.dens.common.compat.emi.RaidDensEMIPlugin"
        ]
    },
    "mixins": [
        "${archives_name}-common.mixins.json",
        "${archives_name}-fabric.mixins.json"
    ],
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/6jBar3y6nt",
                "modmenu.wiki": "https://github.com/necro50n3/cobblemon-raiddens/wiki"
            }
        }
    },
    "depends": {
        "minecraft": "${minecraft_version}",
        "cobblemon": ">=${cobblemon_version}",
        "geckolib": ">=${geckolib_version}",
        "asymmetricbattles": ">=${asymmetricbattles_version}"
    },
    "suggests": {
        "mega_showdown": "*",
        "cobbledollars": ">=2.0.0",
        "rctapi": ">=0.16.0"
    }
}